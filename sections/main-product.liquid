{%- liquid
  assign current_variant = product.selected_or_first_available_variant
-%}

<section class="section" id="buy">
  <div class="container">
    <div class="pdp__grid">

      {%- comment -%} Product gallery: full-bleed swipe carousel (mobile) / image + thumbnails (desktop) {%- endcomment -%}
      <div class="pdp__media" data-carousel data-reveal="left">
        <div class="carousel__viewport" data-carousel-viewport>
          <div class="carousel__track" data-carousel-track>
            {%- if product.images.size > 0 -%}
              {%- for image in product.images -%}
                <div class="carousel__slide">
                  <img
                    src="{{ image | image_url: width: 1000 }}"
                    srcset="{{ image | image_url: width: 600 }} 600w, {{ image | image_url: width: 1000 }} 1000w, {{ image | image_url: width: 1400 }} 1400w"
                    sizes="(min-width: 880px) 52vw, 100vw"
                    alt="{{ image.alt | escape | default: product.title | escape }}"
                    width="1000" height="1000"
                    {% if forloop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %}>
                </div>
              {%- endfor -%}
            {%- else -%}
              <div class="carousel__slide">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
            {%- endif -%}
          </div>
          {%- if product.images.size > 1 -%}
            <button type="button" class="carousel__arrow carousel__arrow--prev" data-carousel-prev aria-label="Previous image">
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M15 18l-6-6 6-6"/></svg>
            </button>
            <button type="button" class="carousel__arrow carousel__arrow--next" data-carousel-next aria-label="Next image">
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 18l6-6-6-6"/></svg>
            </button>
          {%- endif -%}
        </div>

        {%- if product.images.size > 1 -%}
          <div class="carousel__dots" data-carousel-dots>
            {%- for image in product.images -%}
              <button type="button" class="carousel__dot{% if forloop.first %} is-active{% endif %}" data-carousel-go="{{ forloop.index0 }}" aria-label="Go to image {{ forloop.index }}"></button>
            {%- endfor -%}
          </div>
          <div class="carousel__thumbs">
            {%- for image in product.images -%}
              <button type="button" class="carousel__thumb{% if forloop.first %} is-active{% endif %}" data-carousel-go="{{ forloop.index0 }}" aria-label="View image {{ forloop.index }}">
                <img src="{{ image | image_url: width: 160 }}" alt="{{ image.alt | escape }}" loading="lazy" width="76" height="76">
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} Sticky buy column {%- endcomment -%}
      <div class="pdp__buy" data-product-form>
        {%- if section.settings.vendor_label != blank -%}
          <p class="pdp__vendor">{{ section.settings.vendor_label }}</p>
        {%- endif -%}

        <h1 class="pdp__title">{{ product.title }}</h1>

        {%- if section.settings.rating_text != blank -%}
          <div class="rating-line">
            {% render 'stars', rating: 5 %}
            <span>{{ section.settings.rating_text }}</span>
          </div>
        {%- endif -%}

        {%- if section.settings.tagline != blank -%}
          <p class="pdp__tagline">{{ section.settings.tagline }}</p>
        {%- endif -%}

        <div class="price">
          <span class="price__current" data-price-current>{{ current_variant.price | money }}</span>
          <s class="price__compare" data-price-compare {% unless current_variant.compare_at_price > current_variant.price %}hidden{% endunless %}>{{ current_variant.compare_at_price | money }}</s>
          <span class="price__save" data-price-save {% unless current_variant.compare_at_price > current_variant.price %}hidden{% endunless %}>{% if current_variant.compare_at_price > current_variant.price %}Save {{ current_variant.compare_at_price | minus: current_variant.price | times: 100 | divided_by: current_variant.compare_at_price }}%{% endif %}</span>
        </div>

        {%- assign benefit_blocks = section.blocks | where: 'type', 'benefit' -%}
        {%- if benefit_blocks.size > 0 -%}
          <ul class="check-list">
            {%- for block in benefit_blocks -%}
              <li {{ block.shopify_attributes }}>{% render 'icon', name: 'check' %} {{ block.settings.text }}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- form 'product', product, data-ajax-cart: 'true' -%}
          {% render 'variant-pills', product: product, uid: section.id %}

          {%- assign bundle_blocks = section.blocks | where: 'type', 'bundle' -%}
          {%- if bundle_blocks.size > 0 -%}
            <fieldset class="bundle-cards" data-bundle-group>
              <legend class="opt-label">{{ section.settings.bundle_heading }}</legend>
              {%- for block in bundle_blocks -%}
                <label class="bundle-card{% if block.settings.highlight %} bundle-card--highlight{% endif %}" {{ block.shopify_attributes }}>
                  <input
                    type="radio"
                    class="visually-hidden"
                    name="{{ section.id }}-bundle"
                    data-bundle-qty="{{ block.settings.qty }}"
                    data-bundle-discount="{{ block.settings.discount | default: 0 }}"
                    {% if forloop.first %}checked{% endif %}>
                  {%- if block.settings.badge != blank -%}
                    <span class="bundle-card__badge">{{ block.settings.badge }}</span>
                  {%- endif -%}
                  <span class="bundle-card__check">{% render 'icon', name: 'check' %}</span>
                  <span class="bundle-card__body">
                    <span class="bundle-card__title">{{ block.settings.title }}</span>
                    {%- if block.settings.subtitle != blank -%}
                      <span class="bundle-card__sub">{{ block.settings.subtitle }}</span>
                    {%- endif -%}
                    {%- if block.settings.price_text != blank -%}
                      <span class="bundle-card__price">{{ block.settings.price_text }}</span>
                    {%- endif -%}
                  </span>
                  {%- if block.settings.save_text != blank -%}
                    <span class="bundle-card__save">{{ block.settings.save_text }}</span>
                  {%- endif -%}
                </label>
              {%- endfor -%}
            </fieldset>
          {%- endif -%}

          {%- if section.settings.show_low_stock -%}
            <p class="stock-note" data-stock-low data-stock-threshold="{{ section.settings.low_stock_threshold }}" data-stock-text="{{ section.settings.low_stock_text | escape }}" hidden>
              <span class="pulse-dot"></span> <span data-stock-low-text></span>
            </p>
            <script type="application/json" data-stock-json>{
              {%- for v in product.variants -%}
                "{{ v.id }}": { "qty": {{ v.inventory_quantity | default: 0 }}, "tracked": {% if v.inventory_management != blank %}true{% else %}false{% endif %} }{% unless forloop.last %},{% endunless %}
              {%- endfor -%}
            }</script>
          {%- endif -%}

          <input type="hidden" name="id" value="{{ current_variant.id }}">
          <div data-atc-anchor></div>
          <div class="qty-row">
            {%- if bundle_blocks.size > 0 -%}
              <input type="hidden" name="quantity" value="1">
            {%- else -%}
              <div class="qty">
                <button type="button" data-qty-change="-1" aria-label="Decrease quantity">{% render 'icon', name: 'minus' %}</button>
                <input type="number" name="quantity" value="1" min="1" aria-label="Quantity">
                <button type="button" data-qty-change="1" aria-label="Increase quantity">{% render 'icon', name: 'plus' %}</button>
              </div>
            {%- endif -%}
            <button
              type="submit"
              class="btn btn--primary btn--lg"
              data-atc-button
              data-text-add="{{ section.settings.button_label | default: 'Add to Cart' | escape }}"
              data-text-soldout="Sold Out"
              data-text-unavailable="Unavailable"
              {% unless current_variant.available %}disabled{% endunless %}>
              <span data-atc-label>{% if current_variant.available %}{{ section.settings.button_label | default: 'Add to Cart' }}{% else %}Sold Out{% endif %}</span>
            </button>
          </div>
          {%- if section.settings.show_dynamic_checkout -%}
            {{ form | payment_button }}
          {%- endif -%}
          <p class="btn-note">{% render 'icon', name: 'lock' %} {{ section.settings.button_note }}</p>
        {%- endform -%}

        {% render 'offer-urgency',
          sale_text: section.settings.sale_text,
          sale_subtext: section.settings.sale_subtext,
          sale_end: section.settings.sale_end,
          show_delivery: section.settings.show_delivery,
          delivery_min: section.settings.delivery_min,
          delivery_max: section.settings.delivery_max
        %}

        {%- if section.settings.show_countdown -%}
          <div class="countdown-box" data-countdown-cutoff="{{ section.settings.cutoff_hour }}">
            {% render 'icon', name: 'clock' %}
            <span>{{ section.settings.countdown_text }} <strong data-countdown-time>&nbsp;</strong></span>
          </div>
        {%- endif -%}

        {%- if section.settings.stock_note != blank -%}
          <p class="stock-note"><span class="pulse-dot"></span> {{ section.settings.stock_note }}</p>
        {%- endif -%}

        {%- if section.settings.note_heading != blank or section.settings.note_text != blank -%}
          <div class="note-box">
            {% render 'icon', name: 'tool' %}
            <div>
              <strong>{{ section.settings.note_heading }}</strong>
              <p>{{ section.settings.note_text }}</p>
            </div>
          </div>
        {%- endif -%}

        <div class="trust-row">
          <div class="trust-row__item">{% render 'icon', name: 'flag' %}<span>{{ section.settings.trust_1 }}</span></div>
          <div class="trust-row__item">{% render 'icon', name: 'truck' %}<span>{{ section.settings.trust_2 }}</span></div>
          <div class="trust-row__item">{% render 'icon', name: 'shield' %}<span>{{ section.settings.trust_3 }}</span></div>
        </div>

        {%- if section.settings.show_payment_icons -%}
          <div class="payment-icons">
            {%- for type in shop.enabled_payment_types -%}
              {{ type | payment_type_svg_tag }}
            {%- endfor -%}
          </div>
        {%- endif -%}

        <div style="margin-top: 28px">
          {%- if product.description != blank -%}
            <details class="acc" open>
              <summary>The Full Story {% render 'icon', name: 'plus' %}</summary>
              <div class="acc__body rte">{{ product.description }}</div>
            </details>
          {%- endif -%}
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'accordion' -%}
                <details class="acc" {{ block.shopify_attributes }}>
                  <summary>{{ block.settings.title }} {% render 'icon', name: 'plus' %}</summary>
                  <div class="acc__body rte">{{ block.settings.content }}</div>
                </details>
              {%- when '@app' -%}
                {% render block %}
            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</section>

{%- comment -%} Sticky mobile add-to-cart {%- endcomment -%}
<div class="sticky-atc" data-sticky-atc>
  <div class="sticky-atc__meta">
    <div class="sticky-atc__title">{{ product.title }}</div>
    <div class="sticky-atc__price" data-price-current>{{ current_variant.price | money }}</div>
  </div>
  <button type="button" class="btn btn--primary" data-sticky-submit {% unless current_variant.available %}disabled{% endunless %}>
    {% if current_variant.available %}{{ section.settings.button_label | default: 'Add to Cart' }}{% else %}Sold Out{% endif %}
  </button>
</div>

<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": {{ product.title | json }},
  "url": {{ request.origin | append: product.url | json }},
  {% if product.featured_image %}"image": [{{ product.featured_image | image_url: width: 1200 | prepend: 'https:' | json }}],{% endif %}
  "description": {{ product.description | strip_html | truncate: 300 | json }},
  "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
  "offers": {
    "@type": "Offer",
    "price": {{ current_variant.price | divided_by: 100.0 | json }},
    "priceCurrency": {{ cart.currency.iso_code | json }},
    "availability": "{% if current_variant.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}",
    "url": {{ request.origin | append: product.url | json }}
  }
}
</script>

{% schema %}
{
  "name": "Product page",
  "settings": [
    {
      "type": "text",
      "id": "vendor_label",
      "label": "Label above title",
      "default": "Small-Batch Wood Carving"
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating text",
      "info": "Only show a real rating from real reviews."
    },
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Tagline",
      "default": "Hand-carved solid wood. Deep relief detail. Ready to hang the day it arrives."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Add to Cart"
    },
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "Show dynamic checkout button (Shop Pay etc.)",
      "default": true
    },
    {
      "type": "text",
      "id": "bundle_heading",
      "label": "Bundle offers heading",
      "info": "Shown above 'Bundle offer' blocks. Pair with a Shopify automatic volume discount (Discounts → Amount off products → quantity minimum) so the savings are real at checkout.",
      "default": "Bundle & Save"
    },
    {
      "type": "text",
      "id": "button_note",
      "label": "Text under buttons",
      "default": "Secure checkout · 60-day money-back guarantee"
    },
    {
      "type": "header",
      "content": "Workshop note box"
    },
    {
      "type": "text",
      "id": "note_heading",
      "label": "Note heading",
      "default": "From the workshop"
    },
    {
      "type": "textarea",
      "id": "note_text",
      "label": "Note text",
      "default": "Every flag is carved, stained, and sealed by hand, then inspected before it ships. Hand-worked means no two are exactly alike."
    },
    {
      "type": "header",
      "content": "Sale offer",
      "info": "Honest urgency: the box hides itself after the end date."
    },
    {
      "type": "text",
      "id": "sale_text",
      "label": "Sale text",
      "info": "e.g. Father's Day Sale — 30% off everything. Leave blank to hide. Pair with a real discount."
    },
    {
      "type": "text",
      "id": "sale_subtext",
      "label": "Sale subtext",
      "default": "Applied automatically at checkout"
    },
    {
      "type": "text",
      "id": "sale_end",
      "label": "Sale end date (YYYY-MM-DD)",
      "info": "Keep deadlines real — the box disappears after this date."
    },
    {
      "type": "header",
      "content": "Delivery estimate"
    },
    {
      "type": "checkbox",
      "id": "show_delivery",
      "label": "Show \"arrives by\" date range",
      "default": true
    },
    {
      "type": "range",
      "id": "delivery_min",
      "min": 1,
      "max": 30,
      "step": 1,
      "unit": "d",
      "label": "Fastest delivery (days)",
      "default": 8
    },
    {
      "type": "range",
      "id": "delivery_max",
      "min": 2,
      "max": 45,
      "step": 1,
      "unit": "d",
      "label": "Slowest delivery (days)",
      "default": 14
    },
    {
      "type": "header",
      "content": "Urgency"
    },
    {
      "type": "checkbox",
      "id": "show_countdown",
      "label": "Show dispatch countdown",
      "default": false
    },
    {
      "type": "range",
      "id": "cutoff_hour",
      "min": 0,
      "max": 23,
      "step": 1,
      "label": "Daily dispatch cutoff hour (24h, visitor's local time)",
      "default": 14
    },
    {
      "type": "text",
      "id": "countdown_text",
      "label": "Countdown text",
      "default": "Order within"
    },
    {
      "type": "text",
      "id": "stock_note",
      "label": "Scarcity note",
      "info": "Only use if it's true — trust is the whole brand."
    },
    {
      "type": "header",
      "content": "Low-stock indicator",
      "info": "Pulls REAL inventory. Only shows when stock is genuinely at or below the threshold — it never invents a number."
    },
    {
      "type": "checkbox",
      "id": "show_low_stock",
      "label": "Show \"Only X left\" when stock is low",
      "default": true
    },
    {
      "type": "range",
      "id": "low_stock_threshold",
      "min": 1,
      "max": 50,
      "step": 1,
      "label": "Show when stock is at or below",
      "default": 10
    },
    {
      "type": "text",
      "id": "low_stock_text",
      "label": "Low-stock text",
      "info": "Use [count] for the live number.",
      "default": "Only [count] left in stock"
    },
    {
      "type": "header",
      "content": "Trust row"
    },
    {
      "type": "text",
      "id": "trust_1",
      "label": "Trust item 1",
      "default": "Hand-carved solid wood"
    },
    {
      "type": "text",
      "id": "trust_2",
      "label": "Trust item 2",
      "default": "Free insured U.S. shipping"
    },
    {
      "type": "text",
      "id": "trust_3",
      "label": "Trust item 3",
      "default": "60-day money-back guarantee"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit (buy column)",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Benefit text",
          "default": "Carved from solid hardwood"
        }
      ]
    },
    {
      "type": "bundle",
      "name": "Bundle offer (buy column)",
      "settings": [
        {
          "type": "range",
          "id": "qty",
          "min": 1,
          "max": 6,
          "step": 1,
          "label": "Quantity",
          "default": 1
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "1 Flag"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "Just for your wall"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge",
          "info": "e.g. Most Popular"
        },
        {
          "type": "text",
          "id": "save_text",
          "label": "Savings pill",
          "info": "e.g. Save 10% — must match the Discount % below and a real Shopify automatic discount."
        },
        {
          "type": "range",
          "id": "discount",
          "min": 0,
          "max": 50,
          "step": 1,
          "unit": "%",
          "label": "Discount %",
          "info": "Updates the shown price live when this card is picked. MUST match the real automatic discount you create in Discounts, or checkout won't match.",
          "default": 0
        },
        {
          "type": "text",
          "id": "price_text",
          "label": "Price line (optional)",
          "info": "e.g. One to keep, one to give. Extra line under the title. Leave blank if not needed."
        },
        {
          "type": "checkbox",
          "id": "highlight",
          "label": "Highlight as the standout option",
          "info": "Adds a ring + emphasis. Does not pre-select it — the first card stays selected so the shown price is honest.",
          "default": false
        }
      ]
    },
    {
      "type": "accordion",
      "name": "Accordion (buy column)",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Shipping & Returns"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Free insured shipping anywhere in the U.S. In-stock pieces ship within 1 business day. 60-day money-back guarantee — we even cover return shipping.</p>"
        }
      ]
    },
    {
      "type": "tile_banner",
      "name": "Gallery tile: banner",
      "settings": [
        {
          "type": "select",
          "id": "scheme",
          "label": "Color",
          "options": [
            { "value": "navy", "label": "Navy" },
            { "value": "red", "label": "Red" },
            { "value": "cream", "label": "Cream" }
          ],
          "default": "navy"
        },
        {
          "type": "textarea",
          "id": "heading",
          "label": "Heading",
          "default": "A flag worthy of the people who carried it."
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        },
        { "type": "text", "id": "pill_1", "label": "Pill 1", "default": "Hand-carved waving form" },
        { "type": "text", "id": "pill_2", "label": "Pill 2", "default": "Eagle & stars in deep relief" },
        { "type": "text", "id": "pill_3", "label": "Pill 3", "default": "Solid wood, real weight" }
      ]
    },
    {
      "type": "tile_info",
      "name": "Gallery tile: info list",
      "settings": [
        {
          "type": "select",
          "id": "scheme",
          "label": "Color",
          "options": [
            { "value": "cream", "label": "Cream" },
            { "value": "navy", "label": "Navy" },
            { "value": "red", "label": "Red" }
          ],
          "default": "cream"
        },
        {
          "type": "checkbox",
          "id": "full_width",
          "label": "Full width",
          "default": false
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "What's in the box"
        },
        { "type": "text", "id": "item_1", "label": "Item 1", "default": "Your hand-signed, numbered carving" },
        { "type": "text", "id": "item_2", "label": "Item 2", "default": "Keyhole mounts + rated hardware" },
        { "type": "text", "id": "item_3", "label": "Item 3", "default": "Certificate of authenticity" }
      ]
    },
    {
      "type": "tile_guarantee",
      "name": "Gallery tile: guarantee",
      "settings": [
        {
          "type": "select",
          "id": "scheme",
          "label": "Color",
          "options": [
            { "value": "cream", "label": "Cream" },
            { "value": "navy", "label": "Navy" }
          ],
          "default": "cream"
        },
        { "type": "text", "id": "badge_value", "label": "Badge value", "default": "60" },
        { "type": "text", "id": "badge_label", "label": "Badge label", "default": "Days" },
        {
          "type": "textarea",
          "id": "heading",
          "label": "Heading",
          "default": "Hang it risk-free for 60 days"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "If it doesn't stop you in your tracks every time you walk past it, send it back for a full refund. We even cover return shipping."
        }
      ]
    },
    {
      "type": "tile_image",
      "name": "Gallery tile: extra image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "checkbox", "id": "full_width", "label": "Full width", "default": false }
      ]
    },
    {
      "type": "@app"
    }
  ]
}
{% endschema %}
