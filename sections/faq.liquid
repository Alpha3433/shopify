<section class="section section--cream2" id="faq">
  <div class="container">
    <div class="section-head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow" data-reveal>{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 data-reveal style="--reveal-delay: 1">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p data-reveal style="--reveal-delay: 2">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="faq__list">
      {%- for block in section.blocks -%}
        <details class="faq-item" data-reveal style="--reveal-delay: {{ forloop.index0 }}" {{ block.shopify_attributes }}>
          <summary>
            {{ block.settings.question }}
            {% render 'icon', name: 'plus' %}
          </summary>
          <div class="faq-item__a rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Straight Answers"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Questions? We Shoot Straight."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Is it really hand-carved?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Yes — carved from solid wood and finished by hand, in real relief you can feel.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        {
          "type": "question",
          "settings": {
            "question": "Is it really hand-carved?",
            "answer": "<p>Yes. Every flag is carved from solid wood and finished by hand — the stars, stripes, and eagle sit in real relief. Run your fingers across it and you'll feel the depth. Because it's hand-worked, no two are exactly alike.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "How big is it, and is it heavy?",
            "answer": "<p>Sizes are listed on the product page. It’s solid hardwood, so it has real weight to it — that’s the first thing people notice when they pick it up. Mounting hardware rated for the weight is included.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "How do I hang it?",
            "answer": "<p>It arrives ready to hang with keyhole mounts cut into the back and the hardware included. Most folks have it on the wall within five minutes of opening the box.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "How long until it arrives?",
            "answer": "<p>Each flag is dispatched within 2–4 business days, free and fully insured anywhere in the U.S. Delivery typically takes 8–14 days, tracked the whole way — the exact “arrives by” estimate is shown right above the Add to Cart button.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Can I give it as a gift?",
            "answer": "<p>It’s one of the most popular retirement, Veterans Day, and Father’s Day gifts we know of. Add a gift note at checkout — we never include prices in the box.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "What if I don’t love it?",
            "answer": "<p>Tell us within 60 days and we'll refund you in full — you don't even need to ship it back. If it arrives damaged, we replace it free.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
