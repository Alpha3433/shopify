<div class="page-hero">
  <div class="container">
    <p class="eyebrow">Hand-Carved Solid Wood</p>
    <h1>{{ collection.title }}</h1>
    {%- if collection.description != blank -%}
      <p>{{ collection.description | strip_html }}</p>
    {%- endif -%}
  </div>
</div>
<div class="flag-bar" aria-hidden="true"></div>

<section class="section">
  <div class="container">
    {%- paginate collection.products by 12 -%}
      {%- if collection.products.size > 0 -%}
        <div class="collection-grid">
          {%- for product in collection.products -%}
            {% render 'product-card', card_product: product %}
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <nav class="pagination" aria-label="Pagination">
            {%- if paginate.previous -%}
              <a href="{{ paginate.previous.url }}" aria-label="Previous page">&larr;</a>
            {%- endif -%}
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}
                <a href="{{ part.url }}">{{ part.title }}</a>
              {%- elsif part.title == paginate.current_page -%}
                <span class="is-current">{{ part.title }}</span>
              {%- else -%}
                <span>{{ part.title }}</span>
              {%- endif -%}
            {%- endfor -%}
            {%- if paginate.next -%}
              <a href="{{ paginate.next.url }}" aria-label="Next page">&rarr;</a>
            {%- endif -%}
          </nav>
        {%- endif -%}
      {%- else -%}
        <div class="cart-empty">
          <h2>Nothing here yet.</h2>
          <p>New carvings are on the workbench. Check back soon.</p>
          <a href="{{ routes.root_url }}" class="btn btn--primary">Back to Home</a>
        </div>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection page",
  "settings": []
}
{% endschema %}
