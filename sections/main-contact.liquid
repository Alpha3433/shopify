<div class="page-hero">
  <div class="container">
    <h1>{{ page.title }}</h1>
    {%- if section.settings.subheading != blank -%}
      <p>{{ section.settings.subheading }}</p>
    {%- endif -%}
  </div>
</div>
<div class="flag-bar" aria-hidden="true"></div>

<section class="section">
  <div class="container container--narrow">
    {%- if page.content != blank -%}
      <div class="rte" style="margin-bottom: 36px">{{ page.content }}</div>
    {%- endif -%}

    {%- form 'contact' -%}
      {%- if form.posted_successfully? -%}
        <p class="form-success">Message received. We'll get back to you within one business day — a real person, not a robot.</p>
      {%- endif -%}
      {%- if form.errors -%}
        <div class="form-errors">
          <strong>Please fix the following:</strong>
          <ul>
            {%- for field in form.errors -%}
              <li>{{ form.errors.translated_fields[field] }} {{ form.errors.messages[field] }}</li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      <div class="field">
        <label for="ContactName">Name</label>
        <input type="text" id="ContactName" name="contact[name]" value="{{ form.name }}" autocomplete="name">
      </div>
      <div class="field">
        <label for="ContactEmail">Email</label>
        <input type="email" id="ContactEmail" name="contact[email]" value="{{ form.email }}" autocomplete="email" required>
      </div>
      <div class="field">
        <label for="ContactMessage">Message</label>
        <textarea id="ContactMessage" name="contact[body]" rows="6" required>{{ form.body }}</textarea>
      </div>
      <button type="submit" class="btn btn--primary btn--lg">Send Message</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Contact page",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Questions? A real person answers every message — usually within a day."
    }
  ]
}
{% endschema %}
