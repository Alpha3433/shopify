<header class="site-header" data-header>
  <div class="container site-header__inner">
    <div class="site-header__left">
      <button type="button" class="header-icon-btn menu-toggle" data-menu-open aria-label="Open menu">
        {% render 'icon', name: 'menu' %}
      </button>
      <a href="{{ routes.root_url }}" class="site-header__logo">
        {%- if section.settings.logo -%}
          <img
            src="{{ section.settings.logo | image_url: width: 300 }}"
            srcset="{{ section.settings.logo | image_url: width: 300 }} 1x, {{ section.settings.logo | image_url: width: 600 }} 2x"
            alt="{{ shop.name | escape }}"
            width="{{ section.settings.logo_width }}"
            style="width: {{ section.settings.logo_width }}px"
            loading="eager">
        {%- else -%}
          <span class="site-header__wordmark"><span class="star">★</span> {{ shop.name }}</span>
        {%- endif -%}
      </a>
    </div>

    <nav class="site-header__nav" aria-label="Main navigation">
      {%- for link in section.settings.menu.links -%}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {%- endfor -%}
    </nav>

    <div class="site-header__actions">
      <a href="{{ routes.cart_url }}" class="header-icon-btn" data-cart-open aria-label="Open cart">
        {% render 'icon', name: 'cart' %}
        <span class="cart-count-bubble" data-cart-count data-count="{{ cart.item_count }}">{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
</header>

<div class="mobile-menu" id="MobileMenu" aria-hidden="true">
  <div class="mobile-menu__overlay" data-menu-close></div>
  <div class="mobile-menu__panel">
    <div class="mobile-menu__head">
      <span class="site-header__wordmark"><span class="star">★</span> {{ shop.name }}</span>
      <button type="button" class="header-icon-btn" data-menu-close aria-label="Close menu">
        {% render 'icon', name: 'x' %}
      </button>
    </div>
    <nav aria-label="Mobile navigation">
      {%- for link in section.settings.menu.links -%}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {%- endfor -%}
    </nav>
    <div class="mobile-menu__cta">
      <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary btn--full">
        {{ section.settings.mobile_cta_label | default: 'Shop Now' }}
      </a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 80,
      "max": 280,
      "step": 10,
      "unit": "px",
      "label": "Logo width",
      "default": 150
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show account icon",
      "default": true
    },
    {
      "type": "text",
      "id": "mobile_cta_label",
      "label": "Mobile menu button label",
      "default": "Shop Now"
    }
  ]
}
{% endschema %}
