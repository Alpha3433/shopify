{%- assign mode = section.settings.mode | default: 'fixed' -%}
{%- assign show_timer = false -%}
{%- if mode == 'midnight' -%}
  {%- assign show_timer = true -%}
{%- elsif section.settings.deadline != blank -%}
  {%- assign show_timer = true -%}
{%- endif -%}
{%- if section.settings.cta_scroll -%}
  {%- assign cta_href = '#buy' -%}
{%- else -%}
  {%- assign cta_href = section.settings.cta_link | default: routes.all_products_collection_url -%}
{%- endif -%}
{%- assign timer_pos = section.settings.timer_position | default: 'right' -%}

<section class="countdown-bar countdown-bar--pos-{{ timer_pos }}"
  {%- if mode == 'midnight' %} data-countdown-midnight{% elsif show_timer %} data-deadline="{{ section.settings.deadline | escape }}"{% endif -%}
>
  <div class="container countdown-bar__inner">
    {%- if section.settings.heading != blank -%}
      <span class="countdown-bar__text" style="font-size: {{ section.settings.text_size | default: 14 }}px;">{{ section.settings.heading }}</span>
    {%- endif -%}

    {%- if show_timer or section.settings.cta_label != blank -%}
      <div class="countdown-bar__right">
        {%- if show_timer -%}
          <div class="countdown-bar__timer" style="font-size: {{ section.settings.timer_size | default: 16 }}px;" aria-label="Time remaining">
            <span class="countdown-bar__unit"><span class="countdown-bar__num" data-count-htotal>00</span><span class="countdown-bar__label">Hrs</span></span>
            <span class="countdown-bar__unit"><span class="countdown-bar__num" data-count-m>00</span><span class="countdown-bar__label">Min</span></span>
            <span class="countdown-bar__unit"><span class="countdown-bar__num" data-count-s>00</span><span class="countdown-bar__label">Sec</span></span>
          </div>
        {%- endif -%}
        {%- if section.settings.cta_label != blank -%}
          <a href="{{ cta_href }}" class="countdown-bar__cta">{{ section.settings.cta_label }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Countdown banner",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Banner text",
      "info": "The text on the left side of the bar.",
      "default": "Father's Day Sale — 30% Off Everything"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Banner text size",
      "min": 10,
      "max": 26,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "timer_size",
      "label": "Countdown timer size",
      "info": "Scales the whole timer — boxes, numbers and labels together.",
      "min": 12,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "select",
      "id": "timer_position",
      "label": "Timer position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "right"
    },
    {
      "type": "select",
      "id": "mode",
      "label": "Countdown type",
      "options": [
        { "value": "fixed", "label": "Fixed date & time" },
        { "value": "midnight", "label": "Counts down to midnight (resets daily)" }
      ],
      "default": "fixed",
      "info": "“Midnight” counts down to the end of each day in the visitor's local time, then restarts — a perpetual daily urgency timer."
    },
    {
      "type": "text",
      "id": "deadline",
      "label": "Countdown deadline (fixed mode only)",
      "info": "Format: YYYY-MM-DD HH:MM (visitor's local time). The whole banner hides automatically once it passes. Leave blank for no countdown. Tip: keep it under ~4 days so the hours stay short and urgent. Ignored when countdown type is set to Midnight.",
      "default": "2026-06-21 23:59"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label (optional)"
    },
    {
      "type": "checkbox",
      "id": "cta_scroll",
      "label": "Button scrolls to the buy box instead of linking",
      "default": true
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link (when not scrolling)"
    }
  ],
  "presets": [
    {
      "name": "Countdown banner"
    }
  ]
}
{% endschema %}
