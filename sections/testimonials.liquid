<section class="section section--cream2" data-scroller>
  <div class="container">
    <div class="section-head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow" data-reveal>{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 data-reveal style="--reveal-delay: 1">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p data-reveal style="--reveal-delay: 2">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="testimonials__wrap">
      {%- if section.blocks.size > 1 -%}
        <button type="button" class="t-arrow t-arrow--prev" data-scroller-prev aria-label="Previous review">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
      {%- endif -%}

      <div class="testimonials__grid" data-scroller-viewport>
        {%- for block in section.blocks -%}
          <div class="t-card" data-scroller-item data-reveal style="--reveal-delay: {{ forloop.index0 | modulo: 3 }}" {{ block.shopify_attributes }}>
          {%- if block.settings.photo -%}
            <div class="t-card__media">
              <img
                src="{{ block.settings.photo | image_url: width: 760 }}"
                srcset="{{ block.settings.photo | image_url: width: 480 }} 480w, {{ block.settings.photo | image_url: width: 760 }} 760w, {{ block.settings.photo | image_url: width: 1100 }} 1100w"
                sizes="(min-width: 880px) 30vw, 86vw"
                alt="{{ block.settings.name | escape | append: ' — verified buyer photo' }}"
                width="760" height="570" loading="lazy">
            </div>
          {%- endif -%}
          {% render 'stars', rating: block.settings.rating %}
          <p class="t-card__quote">{{ block.settings.quote }}</p>
          <div class="t-card__author">
            <div>
              <div class="t-card__name">{{ block.settings.name }}</div>
              <div class="t-card__loc">{{ block.settings.location }}</div>
            </div>
            {%- if block.settings.verified -%}
              <span class="verified">{% render 'icon', name: 'check-circle' %} Verified</span>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
      </div>

      {%- if section.blocks.size > 1 -%}
        <button type="button" class="t-arrow t-arrow--next" data-scroller-next aria-label="Next review">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 18l6-6-6-6"/></svg>
        </button>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 1 -%}
      <div class="t-dots" data-scroller-dots>
        {%- for block in section.blocks -%}
          <button type="button" class="t-dot{% if forloop.first %} is-active{% endif %}" data-scroller-dot="{{ forloop.index0 }}" aria-label="Go to review {{ forloop.index }}"></button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "From American Homes"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "“Is It Really Hand-Carved?” Ask the Folks Who Own One."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Real words from real owners — fathers, mothers, veterans, and the people who love them."
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Star rating",
          "default": 5
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "You can feel the work in it. This isn’t store-bought junk — it’s the real deal."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Customer name",
          "default": "Tom R."
        },
        {
          "type": "text",
          "id": "location",
          "label": "Location",
          "default": "Amarillo, Texas"
        },
        {
          "type": "image_picker",
          "id": "photo",
          "label": "Proof photo (shown above the review)",
          "info": "Optional. A real buyer's photo of the flag — visual proof shown across the top of the card."
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "Show 'Verified' badge",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "rating": 5,
            "quote": "Bought it for my dad for Father's Day. He's a man of few words. He hung it over the fireplace the same day and just said, “Now that's a flag.”",
            "name": "Sarah K.",
            "location": "Knoxville, Tennessee"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "rating": 5,
            "quote": "I was worried it'd look like the printed stuff at the big-box stores. Then I picked it up. It's heavy, the eagle detail is unreal, and you can see the burn marks where it was worked by hand.",
            "name": "Mike D.",
            "location": "Cedar Rapids, Iowa"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "rating": 5,
            "quote": "Third one I've ordered. One for the house, one for my brother's retirement, one for my son's first home. This is what we'll pass down.",
            "name": "Earl W.",
            "location": "Mobile, Alabama"
          }
        }
      ]
    }
  ]
}
{% endschema %}
