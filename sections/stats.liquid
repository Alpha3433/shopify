<section class="section section--tight">
  <div class="container">
    <div class="stats__grid">
      {%- for block in section.blocks -%}
        <div class="stat" data-reveal style="--reveal-delay: {{ forloop.index0 }}" {{ block.shopify_attributes }}>
          <div class="stat__value">
            <span data-countup="{{ block.settings.value }}">{{ block.settings.value }}</span><span class="stat__suffix">{{ block.settings.suffix }}</span>
          </div>
          <div class="stat__label">{{ block.settings.label }}</div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Stats",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Number",
          "info": "Numbers only (e.g. 2500 or 4.9) — it animates as it scrolls into view.",
          "default": "2500"
        },
        {
          "type": "text",
          "id": "suffix",
          "label": "Suffix",
          "default": "+"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Carvings in American homes"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Stats",
      "blocks": [
        { "type": "stat", "settings": { "value": "2500", "suffix": "+", "label": "Carvings in American homes" } },
        { "type": "stat", "settings": { "value": "50", "suffix": "", "label": "States shipped to" } },
        { "type": "stat", "settings": { "value": "4.9", "suffix": "★", "label": "Average owner rating" } },
        { "type": "stat", "settings": { "value": "100", "suffix": "%", "label": "Hand-carved — never printed" } }
      ]
    }
  ]
}
{% endschema %}
