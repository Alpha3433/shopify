<section class="hero">
  <div class="container hero__grid">
    <div class="hero__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow" data-reveal>{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1 class="hero__title" data-reveal style="--reveal-delay: 1">{{ section.settings.heading }}</h1>
      {%- if section.settings.subheading != blank -%}
        <p class="hero__sub lead" data-reveal style="--reveal-delay: 2">{{ section.settings.subheading }}</p>
      {%- endif -%}
      <div class="hero__cta-row" data-reveal style="--reveal-delay: 3">
        <a href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}" class="btn btn--primary btn--lg">
          {{ section.settings.cta_label }} {% render 'icon', name: 'arrow-right' %}
        </a>
      </div>
      {%- if section.settings.rating_text != blank -%}
        <div class="hero__rating" data-reveal style="--reveal-delay: 4">
          {% render 'stars', rating: 5 %}
          <span>{{ section.settings.rating_text }}</span>
        </div>
      {%- endif -%}
    </div>

    <div class="hero__media" data-reveal="right" style="--reveal-delay: 2">
      {%- if section.settings.corner_badge != blank -%}
        <span class="hero__corner-flag">{{ section.settings.corner_badge }}</span>
      {%- endif -%}
      <div class="hero__media-inner">
        {%- if section.settings.image -%}
          <img
            src="{{ section.settings.image | image_url: width: 900 }}"
            srcset="{{ section.settings.image | image_url: width: 600 }} 600w, {{ section.settings.image | image_url: width: 900 }} 900w, {{ section.settings.image | image_url: width: 1200 }} 1200w"
            sizes="(min-width: 880px) 45vw, 92vw"
            alt="{{ section.settings.image.alt | escape | default: section.settings.heading | escape }}"
            width="900" height="900"
            fetchpriority="high">
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
      {%- if section.settings.badge_text != blank -%}
        <span class="hero__badge">{% render 'icon', name: 'medal' %} {{ section.settings.badge_text }}</span>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Veteran-Owned · Hand-Carved in the USA"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Own a Piece of America That Was Actually Made in America."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Most “patriotic” décor is printed on plastic overseas. Every one of our eagle & flag carvings is cut, burned, and sealed by hand in an American workshop — a tribute worthy of the flag it honors."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Claim Yours — Ships Free"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link",
      "info": "Defaults to your products page if left blank."
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating text",
      "default": "4.9/5 — Trusted by 2,500+ American families"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image",
      "info": "Square product or lifestyle shot works best (min 900×900px)."
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Image badge",
      "default": "Hand-Signed & Numbered"
    },
    {
      "type": "text",
      "id": "corner_badge",
      "label": "Corner badge",
      "default": "100% USA Made"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
