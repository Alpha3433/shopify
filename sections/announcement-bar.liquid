<div class="announcement">
  <div class="announcement__inner">
    {%- assign first = true -%}
    {%- if section.settings.message_1 != blank -%}
      <p class="announcement__msg {% if first %}is-active{% endif %}">{{ section.settings.message_1 }}</p>
      {%- assign first = false -%}
    {%- endif -%}
    {%- if section.settings.message_2 != blank -%}
      <p class="announcement__msg {% if first %}is-active{% endif %}">{{ section.settings.message_2 }}</p>
      {%- assign first = false -%}
    {%- endif -%}
    {%- if section.settings.message_3 != blank -%}
      <p class="announcement__msg {% if first %}is-active{% endif %}">{{ section.settings.message_3 }}</p>
      {%- assign first = false -%}
    {%- endif -%}
    {%- if first -%}
      <p class="announcement__msg is-active">Free U.S. Shipping &middot; 60-Day Money-Back Guarantee</p>
    {%- endif -%}
  </div>
</div>
<div class="flag-bar" aria-hidden="true"></div>

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "paragraph",
      "content": "Messages rotate every 4 seconds. Leave a field blank to skip it."
    },
    {
      "type": "text",
      "id": "message_1",
      "label": "Message 1",
      "default": "★ Father's Day Sale — 30% off everything · Ends Sunday, June 21"
    },
    {
      "type": "text",
      "id": "message_2",
      "label": "Message 2",
      "default": "★ Free U.S. shipping on every order — fully insured"
    },
    {
      "type": "text",
      "id": "message_3",
      "label": "Message 3",
      "default": "Hand-carved solid wood — 60-day money-back guarantee"
    }
  ]
}
{% endschema %}
