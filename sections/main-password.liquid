<section class="section section--navy" style="min-height: 100vh; display: grid; place-items: center;">
  <div class="container text-center" style="max-width: 560px">
    <p class="eyebrow">Coming Soon</p>
    <h1 style="color:#fff; margin: 18px 0">{{ shop.name }}</h1>
    <p class="lead" style="color: rgba(247,242,231,0.8); margin-bottom: 32px">
      {{ section.settings.message }}
    </p>

    {%- form 'storefront_password' -%}
      {%- if form.errors -%}
        <div class="form-errors">Wrong password — give it another shot.</div>
      {%- endif -%}
      <div class="search-bar">
        <input type="password" name="password" placeholder="Store password" aria-label="Password">
        <button type="submit" class="btn btn--primary">Enter</button>
      </div>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Password page",
  "settings": [
    {
      "type": "textarea",
      "id": "message",
      "label": "Message",
      "default": "The workshop doors open soon. Hand-carved American flag art from a veteran-owned shop — worth the wait."
    }
  ]
}
{% endschema %}
