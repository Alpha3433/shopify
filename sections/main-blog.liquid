<div class="page-hero">
  <div class="container">
    <h1>{{ blog.title }}</h1>
  </div>
</div>
<div class="flag-bar" aria-hidden="true"></div>

<section class="section">
  <div class="container">
    {%- paginate blog.articles by 9 -%}
      {%- if blog.articles.size > 0 -%}
        <div class="post-grid">
          {%- for article in blog.articles -%}
            <a href="{{ article.url }}" class="post-card" data-reveal style="--reveal-delay: {{ forloop.index0 | modulo: 3 }}">
              {%- if article.image -%}
                <img src="{{ article.image | image_url: width: 700 }}" alt="{{ article.image.alt | escape | default: article.title | escape }}" loading="lazy" width="700" height="394">
              {%- endif -%}
              <div class="post-card__body">
                <span class="post-card__date">{{ article.published_at | date: '%B %-d, %Y' }}</span>
                <h2 class="post-card__title">{{ article.title }}</h2>
                <p class="post-card__excerpt">{{ article.excerpt_or_content | strip_html | truncate: 140 }}</p>
              </div>
            </a>
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <nav class="pagination" aria-label="Pagination">
            {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">&larr;</a>{%- endif -%}
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}
                <a href="{{ part.url }}">{{ part.title }}</a>
              {%- elsif part.title == paginate.current_page -%}
                <span class="is-current">{{ part.title }}</span>
              {%- else -%}
                <span>{{ part.title }}</span>
              {%- endif -%}
            {%- endfor -%}
            {%- if paginate.next -%}<a href="{{ paginate.next.url }}">&rarr;</a>{%- endif -%}
          </nav>
        {%- endif -%}
      {%- else -%}
        <div class="cart-empty">
          <h2>No posts yet.</h2>
          <p>Stories from the workshop are coming soon.</p>
        </div>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Blog",
  "settings": []
}
{% endschema %}
