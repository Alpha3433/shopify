{%- comment -%} sync-rev: 2 {%- endcomment -%}
<section class="newsletter">
  <div class="container">
    <div class="newsletter__panel">
      <div class="newsletter__copy" data-reveal>
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow" style="color: var(--cream); margin-bottom: 12px">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}
          <p>{{ section.settings.text }}</p>
        {%- endif -%}
      </div>
      <div data-reveal style="--reveal-delay: 1">
        {%- form 'customer', id: 'NewsletterSection' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          {%- if form.posted_successfully? -%}
            <p class="form-success">You're in. Welcome to the family — check your inbox.</p>
          {%- else -%}
            <div class="subscribe-form">
              <input type="email" name="contact[email]" placeholder="Email address" aria-label="Email address" autocomplete="email" required>
              <button type="submit" class="btn btn--gold">{{ section.settings.button_label }}</button>
            </div>
            {%- if form.errors -%}
              <p class="form-errors">{{ form.errors | default_errors }}</p>
            {%- endif -%}
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Join the Family"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Sign up and get 10% off your carving."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Workshop updates, new batches, and a discount code on the house. No spam — we're too busy carving."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Subscribe"
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
