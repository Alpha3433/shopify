{%- comment -%} sync-rev: 2 {%- endcomment -%}
<div class="big-marquee{% if section.settings.color_scheme == 'navy' %} section--navy{% endif %}" aria-hidden="true">
  <div class="big-marquee__track">
    {%- for block in section.blocks -%}
      <span class="big-marquee__item" {{ block.shopify_attributes }}>
        {%- if block.settings.style == 'fill' -%}
          <span class="fill">{{ block.settings.text }}</span>
        {%- else -%}
          {{ block.settings.text }}
        {%- endif -%}
        <span class="big-marquee__star">★</span>
      </span>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Big marquee",
  "max_blocks": 6,
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "cream", "label": "Cream" },
        { "value": "navy", "label": "Navy" }
      ],
      "default": "cream"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Text item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Pass It Down"
        },
        {
          "type": "select",
          "id": "style",
          "label": "Style",
          "options": [
            { "value": "outline", "label": "Outline" },
            { "value": "fill", "label": "Filled italic" }
          ],
          "default": "outline"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Big marquee",
      "blocks": [
        { "type": "item", "settings": { "text": "Hang It Once", "style": "outline" } },
        { "type": "item", "settings": { "text": "Pass It Down", "style": "fill" } },
        { "type": "item", "settings": { "text": "Carved by Hand", "style": "outline" } }
      ]
    }
  ]
}
{% endschema %}
