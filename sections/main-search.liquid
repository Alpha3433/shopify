<div class="page-hero">
  <div class="container">
    <h1>{% if search.performed %}Results for &ldquo;{{ search.terms | escape }}&rdquo;{% else %}Search{% endif %}</h1>
    {%- if search.performed -%}
      <p>{{ search.results_count }} result{% if search.results_count != 1 %}s{% endif %} found</p>
    {%- endif -%}
  </div>
</div>
<div class="flag-bar" aria-hidden="true"></div>

<section class="section">
  <div class="container">
    <form action="{{ routes.search_url }}" method="get" class="search-bar" role="search" style="margin-bottom: 48px">
      <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search our store" aria-label="Search">
      <button type="submit" class="btn btn--primary">{% render 'icon', name: 'search' %} Search</button>
    </form>

    {%- if search.performed -%}
      {%- paginate search.results by 12 -%}
        {%- if search.results.size > 0 -%}
          <div class="collection-grid">
            {%- for item in search.results -%}
              {%- if item.object_type == 'product' -%}
                {% render 'product-card', card_product: item %}
              {%- else -%}
                <a href="{{ item.url }}" class="post-card">
                  <div class="post-card__body">
                    <span class="post-card__date">{{ item.object_type | capitalize }}</span>
                    <h2 class="post-card__title">{{ item.title }}</h2>
                  </div>
                </a>
              {%- endif -%}
            {%- endfor -%}
          </div>

          {%- if paginate.pages > 1 -%}
            <nav class="pagination" aria-label="Pagination">
              {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">&larr;</a>{%- endif -%}
              {%- for part in paginate.parts -%}
                {%- if part.is_link -%}
                  <a href="{{ part.url }}">{{ part.title }}</a>
                {%- elsif part.title == paginate.current_page -%}
                  <span class="is-current">{{ part.title }}</span>
                {%- else -%}
                  <span>{{ part.title }}</span>
                {%- endif -%}
              {%- endfor -%}
              {%- if paginate.next -%}<a href="{{ paginate.next.url }}">&rarr;</a>{%- endif -%}
            </nav>
          {%- endif -%}
        {%- else -%}
          <div class="cart-empty">
            <h2>Nothing found.</h2>
            <p>Try a different search, or head back to the collection.</p>
            <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary">Shop the Collection</a>
          </div>
        {%- endif -%}
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Search page",
  "settings": []
}
{% endschema %}
