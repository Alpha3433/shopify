<section class="section">
  <div class="container">
    <div class="guarantee__panel{% if section.settings.image %} guarantee__panel--photo{% endif %}" data-reveal="zoom">
      {%- if section.settings.image -%}
        <div class="guarantee__media">
          <img
            src="{{ section.settings.image | image_url: width: 640 }}"
            srcset="{{ section.settings.image | image_url: width: 420 }} 420w, {{ section.settings.image | image_url: width: 640 }} 640w, {{ section.settings.image | image_url: width: 900 }} 900w"
            sizes="(min-width: 820px) 280px, 70vw"
            alt="{{ section.settings.image.alt | escape | default: section.settings.heading | escape }}"
            width="640" height="640"
            loading="lazy">
        </div>
      {%- else -%}
        <div class="guarantee__icon">{% render 'icon', name: 'shield' %}</div>
      {%- endif -%}
      <div class="guarantee__content">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
        <p>{{ section.settings.text }}</p>
        <ul class="guarantee__list">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>{% render 'icon', name: 'check' %} {{ block.settings.text }}</li>
          {%- endfor -%}
        </ul>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Guarantee",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photo",
      "info": "Upload a photo to replace the red badge (e.g. the flag on a wall). Leave empty to show the red shield badge."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The Old Glory Promise"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Hang It in Your Home, Risk-Free, for 60 Days."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "If it doesn't stop you in your tracks every time you walk past it, tell us. Full refund, no forms, no hard feelings — you don't even need to ship it back."
    }
  ],
  "max_blocks": 4,
  "blocks": [
    {
      "type": "item",
      "name": "Guarantee point",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "60-day money-back guarantee"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Guarantee",
      "blocks": [
        { "type": "item", "settings": { "text": "60-day money-back guarantee — full refund" } },
        { "type": "item", "settings": { "text": "Free, fully-insured U.S. shipping" } },
        { "type": "item", "settings": { "text": "Arrives damaged? Replaced free — no questions" } }
      ]
    }
  ]
}
{% endschema %}
