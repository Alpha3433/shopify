<section class="section">
  <div class="container">
    <div class="guarantee__panel" data-reveal="zoom">
      <div class="guarantee__icon">{% render 'icon', name: 'shield' %}</div>
      <div class="guarantee__content">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
        <p>{{ section.settings.text }}</p>
        <ul class="guarantee__list">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>{% render 'icon', name: 'check' %} {{ block.settings.text }}</li>
          {%- endfor -%}
        </ul>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Guarantee",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The Old Glory Promise"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Hang It in Your Home, Risk-Free, for 60 Days."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "If it doesn't stop you in your tracks every time you walk past it, send it back. Full refund, no forms, no hard feelings. We can make that promise because almost nobody ever does."
    }
  ],
  "max_blocks": 4,
  "blocks": [
    {
      "type": "item",
      "name": "Guarantee point",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "60-day money-back guarantee"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Guarantee",
      "blocks": [
        { "type": "item", "settings": { "text": "60-day money-back guarantee — full refund" } },
        { "type": "item", "settings": { "text": "Free, fully-insured shipping both ways" } },
        { "type": "item", "settings": { "text": "Lifetime craftsmanship warranty on every carving" } }
      ]
    }
  ]
}
{% endschema %}
