{%- comment -%} sync-rev: 2 {%- endcomment -%}
{% comment %}
  Honest urgency for the buy box.
  - Sale box: shows until end-of-day sale_end (YYYY-MM-DD), then hides itself.
  - Delivery line: concrete "arrives by" date range computed from day settings.
  Params: sale_text, sale_subtext, sale_end, show_delivery, delivery_min, delivery_max
{% endcomment %}
{%- liquid
  assign show_sale = false
  if sale_text != blank
    assign show_sale = true
    if sale_end != blank
      assign end_s = sale_end | date: '%s' | plus: 86399
      assign now_s = 'now' | date: '%s' | plus: 0
      if now_s > end_s
        assign show_sale = false
      endif
    endif
  endif
-%}
{%- if show_sale -%}
  <div class="offer-box">
    {% render 'icon', name: 'gift' %}
    <div>
      <strong>{{ sale_text }}</strong>
      {%- if sale_subtext != blank -%}<span>{{ sale_subtext }}</span>{%- endif -%}
    </div>
  </div>
{%- endif -%}
{%- if show_delivery -%}
  {%- liquid
    assign base_s = 'now' | date: '%s' | plus: 0
    assign min_secs = delivery_min | default: 8 | times: 86400
    assign max_secs = delivery_max | default: 14 | times: 86400
    assign eta_min = base_s | plus: min_secs
    assign eta_max = base_s | plus: max_secs
  -%}
  <p class="delivery-note">
    <span class="delivery-note__dot"></span>
    <span>Order today &mdash; arrives <strong>{{ eta_min | date: '%b %-d' }} &ndash; {{ eta_max | date: '%b %-d' }}</strong>, tracked &amp; insured</span>
  </p>
{%- endif -%}
