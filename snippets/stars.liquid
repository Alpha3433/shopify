{% comment %} Row of 5 stars. Pass rating: 1 to 5 (defaults to 5). {% endcomment %}
{%- assign star_rating = rating | default: 5 | times: 1 -%}
<span class="stars" role="img" aria-label="{{ star_rating }} out of 5 stars">
  {%- for i in (1..5) -%}
    <span {% if i > star_rating %}style="opacity:0.25"{% endif %}><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26"/></svg></span>
  {%- endfor -%}
</span>
