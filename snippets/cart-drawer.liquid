<div class="cart-drawer" id="CartDrawer" aria-hidden="true">
  <div class="cart-drawer__overlay" data-cart-close></div>
  <aside class="cart-drawer__panel" role="dialog" aria-modal="true" aria-label="Shopping cart">
    <div class="cart-drawer__head">
      <h2>Your Cart</h2>
      <button type="button" class="header-icon-btn" data-cart-close aria-label="Close cart">
        {% render 'icon', name: 'x' %}
      </button>
    </div>

    <div class="cart-drawer__ship" data-ship-bar {% if settings.free_shipping_threshold == blank or settings.free_shipping_threshold == 0 %}hidden{% endif %}>
      <p class="ship-bar__label">&nbsp;</p>
      <div class="ship-bar__track"><div class="ship-bar__fill"></div></div>
    </div>

    {%- if settings.cart_urgency != blank -%}
      <div class="cart-drawer__urgency">
        {% render 'icon', name: 'gift' %}
        <span>{{ settings.cart_urgency }}</span>
      </div>
    {%- endif -%}

    <div class="cart-drawer__items" data-cart-items>
      <div class="cart-drawer__empty">
        {% render 'icon', name: 'cart' %}
        <p><strong>Your cart is empty.</strong><br>Bring home a piece of America.</p>
        <a class="btn btn--primary" href="{{ routes.all_products_collection_url }}">Shop the Collection</a>
      </div>
    </div>

    <div class="cart-drawer__foot" data-cart-foot hidden>
      <div class="cart-drawer__subtotal">
        <span>Subtotal</span>
        <span data-cart-subtotal>{{ cart.total_price | money }}</span>
      </div>
      <p class="cart-drawer__note">Shipping &amp; taxes calculated at checkout. Fully insured in transit — damaged pieces are replaced free.</p>
      <a href="{{ routes.cart_url }}/checkout" class="btn btn--primary btn--full btn--lg">
        {% render 'icon', name: 'lock' %} Secure Checkout
      </a>
      {%- if shop.enabled_payment_types.size > 0 -%}
        <div class="cart-payments">
          {%- for type in shop.enabled_payment_types -%}
            {{ type | payment_type_svg_tag }}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </aside>
</div>
