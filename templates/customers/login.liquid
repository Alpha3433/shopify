<section class="section">
  <div class="container">
    <div class="form-card">
      <h1>Welcome Back</h1>
      <p>Sign in to your account.</p>

      {%- form 'customer_login' -%}
        {%- if form.errors -%}
          <div class="form-errors">{{ form.errors | default_errors }}</div>
        {%- endif -%}
        <div class="field">
          <label for="CustomerEmail">Email</label>
          <input type="email" id="CustomerEmail" name="customer[email]" autocomplete="email" required>
        </div>
        <div class="field">
          <label for="CustomerPassword">Password</label>
          <input type="password" id="CustomerPassword" name="customer[password]" autocomplete="current-password" required>
        </div>
        <button type="submit" class="btn btn--primary btn--full">Sign In</button>
      {%- endform -%}

      <div class="form-links">
        <a href="{{ routes.account_register_url }}">Create an account</a>
      </div>

      <details style="margin-top: 24px">
        <summary style="cursor:pointer; font-weight:700">Forgot your password?</summary>
        <div style="margin-top: 16px">
          {%- form 'recover_customer_password' -%}
            {%- if form.posted_successfully? -%}
              <p class="form-success">We've emailed you a link to reset your password.</p>
            {%- endif -%}
            {%- if form.errors -%}
              <div class="form-errors">{{ form.errors | default_errors }}</div>
            {%- endif -%}
            <div class="field">
              <label for="RecoverEmail">Email</label>
              <input type="email" id="RecoverEmail" name="email" autocomplete="email" required>
            </div>
            <button type="submit" class="btn btn--outline btn--full">Send Reset Link</button>
          {%- endform -%}
        </div>
      </details>
    </div>
  </div>
</section>
