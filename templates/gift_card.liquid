{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Gift Card · {{ shop.name }}</title>
  <meta name="robots" content="noindex">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
  {{ 'base.css' | asset_url | stylesheet_tag }}
</head>
<body>
  <section class="section section--navy" style="min-height: 100vh; display: grid; place-items: center">
    <div class="container text-center" style="max-width: 520px">
      <p class="eyebrow">A Gift From {{ shop.name }}</p>
      <h1 style="color:#fff; margin: 16px 0">{{ gift_card.initial_value | money }} Gift Card</h1>
      {%- if gift_card.enabled == false or gift_card.expired -%}
        <p class="lead" style="color: rgba(247,242,231,0.8)">This gift card has expired.</p>
      {%- else -%}
        <p class="lead" style="color: rgba(247,242,231,0.8)">Current balance: {{ gift_card.balance | money }}</p>
      {%- endif -%}
      <div class="form-card" style="margin-top: 28px">
        <p style="margin-bottom: 8px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; font-size: 0.78rem">Your code</p>
        <p style="font-family: var(--font-display); font-size: 1.6rem; letter-spacing: 0.08em">{{ gift_card.code | format_code }}</p>
      </div>
      <a href="{{ shop.url }}" class="btn btn--primary btn--lg" style="margin-top: 28px">Start Shopping</a>
      <p style="margin-top: 16px"><button onclick="window.print()" class="cart-line__remove" style="color: rgba(247,242,231,0.7)">Print this gift card</button></p>
    </div>
  </section>
</body>
</html>
